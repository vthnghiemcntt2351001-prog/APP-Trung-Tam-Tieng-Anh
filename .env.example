# ==============================================================================
# HỆ THỐNG QUẢN LÝ TRUNG TÂM TIẾNG ANH - CẤU HÌNH MÔI TRƯỜNG (.env.example)
# ==============================================================================

# Cấu hình Django Core
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-very-strong-secret-key-in-production-1234567890
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,yourdomain.com

# Cấu hình Cơ sở dữ liệu (MySQL 8.0)
DB_ENGINE=mysql
DB_NAME=english_center_db
DB_USER=english_user
DB_PASSWORD=english_secure_password_2026
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Cấu hình Email (Dùng console trong dev, smtp trong production)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Cấu hình Bảo mật SSL/HTTPS (Khi deploy HTTPS thật)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=31536000
